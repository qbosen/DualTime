        "stringUnit": {
          "state": "translated",
          "value": "行为"
        }
      }
    }
  },
  "behavior.rehide": {
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Hide time panel"
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "重新隐藏"
        }
      }
    }
  },
  "behavior.pointerExit": {
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "When the pointer leaves the clock or panel"
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "指针离开时钟或面板时"
        }
      }
    }
  },
  "behavior.outsideClick": {
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "When clicking elsewhere"
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "点击其他位置时"
        }
      }
    }
  },
  "behavior.hint": {
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Moving back to the clock or panel cancels the countdown. Never disables pointer-exit hiding only. Click the clock again or press Esc to close the panel."
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "移回时钟或面板会取消倒计时。“从不”仅关闭指针离开后的自动隐藏。再次点击时钟或按 Esc 仍可关闭面板。"
        }
      }
    }
  },
  "behavior.delay.immediately": {
